.param VDD_REF = 3.3V
.param R_RBIAS_REF = 3300
.param I_RBIAS_SENSE = 1e-3 ; Assumed internal current for RBIAS sensing

* --- Absolute Maximum Ratings (for behavioral checks, not directly modeled as limits) ---
.param VDD_MAX = 7.0
.param VIN_MAX_ABS = 7.5 ; VDD + 0.5V
.param VIN_MIN_ABS = -0.5

* --- Electrical Characteristics ---
.param VTH_TYP = 1.5 ; Typical input threshold voltage
.param VHYST = 0.3 ; Hysteresis for Schmitt triggers
.param VTL = {VTH_TYP - VHYST/2} ; Low threshold
.param VTH = {VTH_TYP + VHYST/2} ; High threshold
.param R_IN_DIGITAL = 3.3e6 ; Input resistance for digital inputs (VDD/II_MAX = 3.3V/1uA)
.param R_IN_VCO = 10e6 ; VCO_IN input impedance
.param R_OUT_VCO = 300 ; VCO_OUT output resistance (average of VOH/VOL specs)
.param I_CP_MAX = 100e-6 ; Max charge pump current (100uA)

* --- VCO Frequency Parameters (derived from VDD=
.ends TLC2932A