{
  "ic_device": {
    "name": "LM358B/LM2904B",
    "category": "Operational Amplifier",
    "description": "The LM358B and LM2904B devices are next-generation, industry-standard dual operational amplifiers (op amps) offering high-voltage (36V) operation, low offset voltage, common-mode input range to ground, high differential input voltage capability, unity-gain stability, lower quiescent current, high ESD, and integrated EMI/RF filters for cost-sensitive and rugged applications."
  },
