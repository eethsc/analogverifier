{
  "ic_device": {
    "name": "LM317",
    "category": "Adjustable Linear Voltage Regulator",
    "description": "Adjustable three-pin positive-voltage regulator capable of supplying more than 1.5A over an output voltage range of 1.25V to 37V. Requires only two external resistors to set output voltage. Features current limiting, thermal overload protection, and safe operating area protection.",
    "package": "TO-220 (KCS/KCT, 3-pin, Legacy Chip)"
  },
  "pins": [
    {
      "name": "INPUT",
      "pin_number": "3",
      "role": "POWER",
      "direction": "INPUT",
      "description": "Input voltage pin for the regulator.",
      "page": 5,
      "evidence": "Input voltage pin for the regulator."
    },
    {
      "name": "OUTPUT",
      "pin_number": "2, TAB",
      "role": "OUTPUT",
      "direction": "OUTPUT",
      "description": "Output voltage pin for the regulator. Tab is internally connected to OUTPUT.",
      "page": 5,
      "evidence": "Output voltage pin for the regulator."
    },
    {
      "name": "ADJUST",
      "pin_number": "1",
      "role": "FEEDBACK",
      "direction": "INPUT",
      "description": "Output voltage adjustment pin. Connect to a resistor divider to set VOUT.",
      "page": 5,
      "evidence": "Output voltage adjustment pin. Connect to a resistor divider to set VOUT."
    }
  ],
  "port_dependencies": [
    {
      "source": "INPUT",
      "target": "OUTPUT",
      "dependency_type": "POWER_FEED",
      "settling_delay_us": null,
      "condition": "Requires up to 3V headroom (VI \u2013 VO) to operate in regulation."
    },
    {
      "source": "ADJUST",
      "target": "OUTPUT",
      "dependency_type": "FEEDBACK_LOOP",
      "settling_delay_us": null,
      "condition": "Device OUTPUT pin sources current necessary to make the OUTPUT pin 1.25V greater than ADJUST pin to provide output regulation."
    }
  ],
  "functional_blocks": [
    {
      "name": "NPN Darlington Output Drive",
      "type": "Output Stage",
      "description": "Provides naturally low output impedance. Output capacitor is optional. Requires 3V headroom (VI \u2013 VO) to support maximum current and lowest temperature.",
      "input_ports": [
        "INPUT"
      ],
      "output_ports": [
        "OUTPUT"
      ]
    },
    {
      "name": "Overload Protection Block",
      "type": "Protection",
      "description": "Overcurrent and overtemperature shutdown protects the device against overload or damage from operating in excessive heat. Automatically resets from overload. Functional even if ADJUST pin is disconnected.",
      "input_ports": [
        "INPUT",
        "OUTPUT"
      ],
      "output_ports": [
        "OUTPUT"
      ]
    },
    {
      "name": "Programmable Feedback (Error Amplifier)",
      "type": "Control Loop",
      "description": "Op amp with a 1.25V offset input at the ADJUST pin provides easy output voltage or current programming. Minimizes IADJUST current and keeps it constant with line and load changes.",
      "input_ports": [
        "ADJUST",
        "OUTPUT"
      ],
      "output_ports": [
        "OUTPUT"
      ]
    },
    {
      "name": "Internal Reference",
      "type": "Reference",
      "description": "1.25V internal reference voltage between OUTPUT and ADJUST pins.",
      "input_ports": [],
      "output_ports": [
        "ADJUST"
      ]
    }
  ],
