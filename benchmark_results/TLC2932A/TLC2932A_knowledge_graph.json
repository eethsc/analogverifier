{
  "ic_device": {
    "name": "TLC2932A",
    "category": "Phase-Locked Loop (PLL)",
    "description": "The TLC2932A is designed for phase-locked loop (PLL) systems and is composed of a voltage-controlled oscillator (VCO) and an edge-triggered type phase frequency detector (PFD). The oscillation frequency range of the VCO is set by an external bias resistor (RBIAS). The VCO has a 1/2 frequency divider at the output stage. The high speed PFD with internal charge pump detects the phase difference between the reference frequency input and signal frequency input from the external counter. Both the VCO and the PFD have inhibit functions, which can be used as power-down mode. Due to the TLC2932A high speed and stable oscillation capability, the TLC2932A is suitable for use as a high-performance PLL."
  },
  "pins": [
    {
      "name": "LOGIC_VDD",
      "pin_number": "1",
      "direction": "POWER",
      "role": "POWER",
      "description": "Power supply for the internal logic. This power supply should be separated from VCO VDD to reduce cross-coupling between supplies."
    },
    {
      "name": "SELECT",
      "pin_number": "2",
      "direction": "INPUT",
      "role": "CONTROL",
      "description": "VCO output frequency select. When SELECT is high, the VCO output frequency is \u00d71/2 and when low. The output frequency is \u00d71."
    },
    {
      "name": "VCO_OUT",
      "pin_number": "3",
      "direction": "OUTPUT",
      "role": "OUTPUT",
      "description": "VCO output. When the VCO INHIBIT is high, VCO output is low."
    },
    {
      "name": "FIN_A",
      "pin_number": "4",
      "direction": "INPUT",
      "role": "SIGNAL",
      "description": "Input reference frequency f(REF IN) is applied to FIN\u2212A."
    },
    {
      "name": "FIN_B",
      "pin_number": "5",
      "direction": "INPUT",
      "role": "SIGNAL",
      "description": "Input for VCO external counter output frequency f(FIN\u2212B). FIN\u2212B is nominally provided from the external counter."
    },
    {
      "name": "PFD_OUT",
      "pin_number": "6",
      "direction": "OUTPUT",
      "role": "OUTPUT",
      "description": "PFD output. When the PFD INHIBIT is high, PFD output is in the high-impedance state."
    },
    {
      "name": "LOGIC_GND",
      "pin_number": "7",
      "direction": "GROUND",
      "role": "GROUND",
      "description": "GND for the internal logic."
    },
    {
      "name": "TEST",
      "pin_number": "8",
      "direction": "INPUT",
      "role": "CONTROL",
      "description": "Connect to GND."
    },
    {
      "name": "PFD_INHIBIT",
      "pin_number": "9",
      "direction": "INPUT",
      "role": "ENABLE",
      "description": "PFD inhibit control. When PFD INHIBIT is high, PFD output is in the high-impedance state."
    },
    {
      "name": "VCO_INHIBIT",
      "pin_number": "10",
      "direction": "INPUT",
      "role": "ENABLE",
      "description": "VCO inhibit control. When VCO INHIBIT is high, VCO output is low."
    },
    {
      "name": "VCO_GND",
      "pin_number": "11",
      "direction": "GROUND",
      "role": "GROUND",
      "description": "GND for VCO."
    },
    {
      "name": "VCO_IN",
      "pin_number": "12",
      "direction": "INPUT",
      "role": "CONTROL",
      "description": "VCO control voltage input. Nominally the external loop filter output connects to VCO IN to control VCO oscillation frequency."
    },
    {
      "name": "RBIAS",
      "pin_number": "13",
      "direction": "INPUT",
      "role": "BIAS",
      "description": "Bias supply. An external resistor (RBIAS) between VCO VDD and RBIAS supplies bias for adjusting the oscillation frequency range."
    },
    {
      "name": "VCO_VDD",
      "pin_number": "14",
      "direction": "POWER",
      "role": "POWER",
      "description": "Power supply for VCO. This power supply should be separated from LOGIC VDD to reduce cross-coupling between supplies."
    }
  ],
